<%- include('partials/header') %>

<div class="container my-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="text-white fw-black text-uppercase display-5">
            Maps
        </h1>
        <p class="text-secondary">
            Featured competitive maps + full map collection
        </p>
    </div>

    <!-- 🔥 Featured Maps -->
    <h3 class="text-white mb-3">Featured Maps</h3>

    <div class="row g-4 mb-5">

        <% featuredMaps.forEach(map => { %>
            <div class="col-12 col-md-6 col-lg-4 d-flex">

                <div class="map-card w-100">

                    <% if (map.splash) { %>
                        <img src="<%= map.splash %>" class="map-card-img">
                    <% } %>

                    <div class="map-card-overlay"></div>

                    <div class="map-card-content">
                        <h3 class="text-uppercase fw-bold">
                            <%= map.displayName %>
                        </h3>

                        <p class="text-secondary mb-1">
                            <%= map.tacticalDescription %>
                        </p>
                                                <% if (map.coordinates) { %>
                            <small class="text-secondary opacity-50">
                                <%= map.coordinates %>
                            </small>
                        <% } %>
                    </div>

                </div>

            </div>
        <% }) %>

    </div>

    <!-- 👇 Toggle Button -->
    <div class="text-center mb-4">
        <button id="toggleMapsBtn" class="btn btn-outline-danger">
            Show More Maps
        </button>
    </div>

    <!-- 📦 Hidden Maps -->
    <div id="extraMaps" class="row g-4 d-none">

        <% otherMaps.forEach(map => { %>
            <div class="col-12 col-md-6 col-lg-4 d-flex">

                <div class="map-card w-100">

                    <% if (map.splash) { %>
                        <img src="<%= map.splash %>" class="map-card-img">
                    <% } %>

                    <div class="map-card-overlay"></div>

                    <div class="map-card-content">
                        <h3 class="text-uppercase fw-bold">
                            <%= map.displayName %>
                        </h3>

                        <!-- <p class="text-secondary">
                            No tactical overview available
                        </p> -->
                    </div>

                </div>

            </div>
        <% }) %>

    </div>

</div>

<!-- JS Toggle -->
<script>
document.getElementById("toggleMapsBtn").addEventListener("click", function () {
    const extraMaps = document.getElementById("extraMaps");

    extraMaps.classList.toggle("d-none");

    this.textContent = extraMaps.classList.contains("d-none")
        ? "Show More Maps"
        : "Show Less Maps";
});
</script>

<%- include('partials/footer') %>