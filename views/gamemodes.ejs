<%- include('partials/header') %>

    <div class="container my-5">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="text-danger fw-bold display-5">GAME MODES</h1>
            <p class="text-secondary">
                Explore different Valorant gameplay modes and rulesets.
            </p>
        </div>

        <!-- Grid -->
        <div class="row g-4">

            <% gamemodes.forEach(mode=> { %>

                <div class="col-12 col-md-6 col-lg-4">

                    <div class="gamemode-card">

                        <!-- Image -->
                        <% if (mode.listViewIconTall || mode.displayIcon) { %>
                            <img src="<%= mode.listViewIconTall || mode.displayIcon %>" class="gamemode-img"
                                alt="<%= mode.displayName %>">
                            <% } %>

                                <!-- Content -->
                                <div class="gamemode-content p-3">

                                    <h4 class="text-white fw-bold text-uppercase">
                                        <%= mode.displayName %>
                                    </h4>

                                    <p class="text-secondary small">
                                        <%= mode.description %>
                                    </p>

                                    <% if (mode.duration) { %>
                                        <span class="gamemode-badge">
                                            ⏱ <%= mode.duration %>
                                        </span>
                                        <% } %>

                                </div>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>

    <%- include('partials/footer') %>