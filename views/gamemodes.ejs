<%- include('partials/header') %>

    <div class="container my-5">

        <div class="text-center mb-5 agents-header">
            <span class="agents-subtitle text-uppercase fw-bold" style="color: #ff4655; letter-spacing: 2px;">
                Rules of Engagement
            </span>
            <h1 class="text-white text-uppercase display-4 mt-2" style="font-weight: 900; letter-spacing: 1px;">
                Game Modes
            </h1>
            <div class="agents-header-line mx-auto my-3" style="width: 60px; height: 3px; background-color: #ff4655;">
            </div>
            <p class="text-secondary col-md-8 mx-auto mt-3 fs-5">
                Explore different Valorant gameplay modes and rulesets.
            </p>
        </div>

        <div class="row g-4 justify-content-center">

            <% gamemodes.forEach(mode=> { %>

                <div class="col-12 col-md-6 col-lg-4 d-flex">

                    <div class="gamemode-card w-100">

                        <div class="gamemode-img-container">
                            <% if (mode.listViewIconTall || mode.displayIcon) { %>
                                <img src="<%= mode.listViewIconTall || mode.displayIcon %>" class="gamemode-img"
                                    alt="<%= mode.displayName %>">
                                <% } %>
                        </div>

                        <div class="gamemode-content">
                            <h4 class="fw-bold text-uppercase m-0 mb-2">
                                <%= mode.displayName %>
                            </h4>

                            <p class="small">
                                <%= mode.description %>
                            </p>

                            <% if (mode.duration) { %>
                                <span class="gamemode-badge">
                                    ⏱ <%= mode.duration %>
                                </span>
                                <% } %>
                        </div>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>

    <%- include('partials/footer') %>