<%- include('partials/header') %>

<div class="container my-5">
    
    <button onclick="history.back()" class="wd-back-btn btn btn-link p-0 mb-4 d-inline-flex align-items-center gap-2" style="text-decoration: none;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Back to Weapon
    </button>

    <div class="sd-hero text-center mb-5 pb-5 border-bottom" style="border-color: rgba(255,255,255,0.05) !important;">
        <h1 class="text-white text-uppercase fw-black mb-4" style="font-size: 3.5rem; letter-spacing: 2px;">
            <%= skin.displayName %>
        </h1>
        <div class="sd-hero-img-wrap">
            <img src="<%= skin.chromas?.[0]?.fullRender || skin.displayIcon %>" alt="<%= skin.displayName %>" class="sd-hero-img" id="sdHeroImage" fetchpriority="high">
        </div>
    </div>

    <% if (skin.chromas && skin.chromas.length > 1) { %>
        <div class="mb-5">
            <h2 class="wd-section-title">Color Variants</h2>
            <div class="row g-4">
                <% skin.chromas.forEach((chroma, index) => { %>
                    <div class="col-md-6 col-lg-4">
                        <button
                            type="button"
                            class="sd-card sd-chroma-card <%= index === 0 ? 'active' : '' %>"
                            data-image="<%= chroma.fullRender || chroma.displayIcon || skin.displayIcon %>"
                            data-name="<%= chroma.displayName %>">
                            <div class="sd-card-img-wrap">
                                <img src="<%= chroma.fullRender || chroma.displayIcon %>" alt="<%= chroma.displayName %>">
                            </div>
                            <div class="sd-card-footer">
                                <span><%= chroma.displayName.replace(skin.displayName, '').trim() || 'Base Variant' %></span>
                                <% if (chroma.swatch) { %>
                                    <img src="<%= chroma.swatch %>" class="sd-swatch" alt="Swatch">
                                <% } %>
                            </div>
                        </button>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

<% if (skin.levels && skin.levels.length > 1) { %>
        <% const selectedLevel = skin.levels.find(level => level.streamedVideo) || skin.levels[0]; %>
        <div class="mb-5">
            <h2 class="wd-section-title text-center mb-4">Evolution Upgrades</h2>
            
            <div class="sd-level-viewer">
                <div class="sd-level-media">
                    <video
                        src="<%= selectedLevel.streamedVideo || '' %>"
                        autoplay
                        loop
                        muted
                        playsinline
                        controls
                        preload="none"
                        disableRemotePlayback
                        class="sd-video <%= selectedLevel.streamedVideo ? '' : 'd-none' %>"
                        id="sdLevelVideo">
                    </video>
                    
                    <div class="sd-card-img-wrap <%= selectedLevel.streamedVideo ? 'd-none' : '' %>" id="sdLevelImageWrap">
                        <img
                            src="<%= selectedLevel.displayIcon || skin.displayIcon %>"
                            alt="Level Icon"
                            id="sdLevelImage">
                    </div>

                    <div class="sd-hud-overlay">
                        <span class="sd-level-badge" id="sdLevelBadge">Level <%= skin.levels.indexOf(selectedLevel) + 1 %></span>
                        <span class="sd-level-title" id="sdLevelTitle"><%= selectedLevel.levelItem ? selectedLevel.levelItem.replace('EEquippableSkinLevelItem::', '') : 'Base Weapon' %></span>
                    </div>
                </div>
            </div>

            <div class="sd-level-switcher" aria-label="Select weapon level">
                <% skin.levels.forEach((level, index) => { %>
                    <button
                        type="button"
                        class="sd-level-btn <%= level === selectedLevel ? 'active' : '' %>"
                        data-level="<%= index + 1 %>"
                        data-title="<%= level.levelItem ? level.levelItem.replace('EEquippableSkinLevelItem::', '') : 'Base Weapon' %>"
                        data-video="<%= level.streamedVideo || '' %>"
                        data-image="<%= level.displayIcon || skin.displayIcon %>">
                        Level <%= index + 1 %>
                    </button>
                <% }) %>
            </div>
        </div>
    <% } %>

</div>

<script>
    const heroImage = document.getElementById('sdHeroImage');
    const chromaCards = document.querySelectorAll('.sd-chroma-card');
    const levelVideo = document.getElementById('sdLevelVideo');
    const levelImageWrap = document.getElementById('sdLevelImageWrap');
    const levelImage = document.getElementById('sdLevelImage');
    const levelBadge = document.getElementById('sdLevelBadge');
    const levelTitle = document.getElementById('sdLevelTitle');
    const levelButtons = document.querySelectorAll('.sd-level-btn');

    chromaCards.forEach((card) => {
        card.addEventListener('click', () => {
            chromaCards.forEach((item) => item.classList.remove('active'));
            card.classList.add('active');

            heroImage.src = card.dataset.image;
            heroImage.alt = card.dataset.name;
        });
    });

    levelButtons.forEach((button) => {
        button.addEventListener('click', () => {
            levelButtons.forEach((item) => item.classList.remove('active'));
            button.classList.add('active');

            levelBadge.textContent = `Level ${button.dataset.level}`;
            levelTitle.textContent = button.dataset.title;

            if (button.dataset.video) {
                levelImageWrap.classList.add('d-none');
                levelVideo.classList.remove('d-none');

                if (levelVideo.getAttribute('src') !== button.dataset.video) {
                    levelVideo.src = button.dataset.video;
                    levelVideo.load();
                }

                levelVideo.play().catch(() => {});
                return;
            }

            levelVideo.pause();
            levelVideo.removeAttribute('src');
            levelVideo.load();
            levelVideo.classList.add('d-none');
            levelImage.src = button.dataset.image;
            levelImageWrap.classList.remove('d-none');
        });
    });
</script>

<%- include('partials/footer') %>
