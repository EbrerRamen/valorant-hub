<%- include('partials/header') %>

    <div class="container mt-4">

        <h1 class="text-center text-danger mb-4">Agents</h1>

        <div class="container mb-4 text-center">

            <div class="role-filters">

                <!-- ALL -->
                <div class="role-icon role-all active-role" data-role="all">
                    ALL
                </div>

                <!-- Dynamically from agents -->
                <% const rolesMap=new Map(); agents.forEach(a=> {
                    if (a.role && !rolesMap.has(a.role.displayName)) {
                    rolesMap.set(a.role.displayName, a.role.displayIcon);
                    }
                    });
                    %>

                    <% for (let [name, icon] of rolesMap) { %>
                        <img src="<%= icon %>" class="role-icon" data-role="<%= name %>" title="<%= name %>" />
                        <% } %>

            </div>

        </div>
        <div class="row">

            <% agents.forEach(agent=> { %>

                <div class="col-6 col-md-4 col-lg-3 mb-4">

                    <div class="agent-card text-center" data-role="<%= agent.role?.displayName %>">
                        <img src="<%= agent.fullPortrait || agent.displayIcon %>" alt="<%= agent.displayName %>"
                            class="agent-portrait">
                        <p class="mt-2 text-white fw-bold">
                            <%= agent.displayName %>
                        </p>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>

    <script>
        const roleIcons = document.querySelectorAll(".role-icon");
        const cards = document.querySelectorAll(".agent-card");

        roleIcons.forEach(icon => {
            icon.addEventListener("click", () => {

                const role = icon.getAttribute("data-role");

                // active state UI
                roleIcons.forEach(i => i.classList.remove("active-role"));
                icon.classList.add("active-role");

                // filter logic
                cards.forEach(card => {
                    const cardRole = card.getAttribute("data-role");

                    if (role === "all" || cardRole === role) {
                        card.parentElement.style.display = "block";
                    } else {
                        card.parentElement.style.display = "none";
                    }
                });

            });
        });
    </script>

    <%- include('partials/footer') %>